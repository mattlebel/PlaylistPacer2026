# Postgres. Leave unset locally to use the embedded database in .data/ (no setup needed).
# DATABASE_URL=postgres://user:pass@host:5432/db

# Spotify app: https://developer.spotify.com/dashboard
# Redirect URI: http://127.0.0.1:3000/spotify/callback (plus your deployed URL + /spotify/callback)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
# Enables song search for friends (server-side, never sent to the browser).
SPOTIFY_CLIENT_SECRET=

# Optional: confirmation emails with edit links, via https://resend.com
# EMAIL_FROM must be an address on a domain you've verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Playlist Pacer <songs@yourdomain.com>"

# Optional: public origin when behind a proxy (used in emailed links and link previews)
# APP_URL=https://playlistpacer.example.com
