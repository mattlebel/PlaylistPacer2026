# Spotify — create an app at https://developer.spotify.com/dashboard
# Redirect URI: http://127.0.0.1:3000/spotify/callback (Spotify no longer accepts "localhost")
# PKCE flow: only the client ID is needed, no secret.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Strava — create an app at https://www.strava.com/settings/api
# Authorization Callback Domain: 127.0.0.1 (or your deployed domain)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional: public origin when behind a proxy (used for OAuth redirects)
# APP_URL=https://kickdrop.example.com
# Optional: Strava moves to api-v3.strava.com on 2027-01-04
# STRAVA_API_BASE=https://www.strava.com/api/v3
